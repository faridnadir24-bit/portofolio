  file_change {
    absolute_path_uri: "file:///src/data/portfolioData.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Project, SkillCategory, TimelineItem } from \'../types\';\n\nexport const PERSONAL_INFO = {\n  name: \'Farid Nadir Amrulloh\',\n  shortName: \'Farid Nadir\',\n  title: \'Mahasiswa Teknik Informatika\',\n  university: \'STT Wastukancana Purwakarta\',\n  period: \'2025 \342\200\223 Sekarang\',\n  location: \'Purwakarta, Jawa Barat, Indonesia\',\n  email: \'faridnadir24@gmail.com\',\n  whatsappNumber: \'6281234567890\', // placeholder format for direct wa link generator\n  whatsappDisplay: \'+62 812-xxxx-xxxx\',\n  githubUrl: \'https://github.com/#\',\n  linkedinUrl: \'https://linkedin.com/in/#\',\n  tagline: \'Membangun solusi perangkat lunak berbasis AI, IoT, dan analisis data cerdas dengan integritas, disiplin, dan dampak nyata.\',\n  bio: \'Saya adalah mahasiswa Teknik Informatika di STT Wastukancana yang berdedikasi dalam merancang dan mengembangkan sistem komputasi terapan. Menggabungkan ketelitian rekayasa perangkat lunak dengan kecerdasan buatan (AI) serta sistem tertanam IoT untuk menyelesaikan permasalahan nyata di sektor energi terbarukan, pangan, dan lingkungan maritim. Memiliki pengalaman kepemimpinan sebagai Ketua Komisi A MPK SMA yang memperkuat kemampuan komunikasi, manajemen tim, dan kedisiplinan eksekusi.\',\n  status: \'Terbuka untuk Kolaborasi Riset & Proyek Teknologi\',\n};\n\nexport const PROJECTS: Project[] = [\n  {\n    id: \'avo-bio\',\n    title: \'AVO-BIO\',\n    slug: \'avo-bio-demo\',\n    tagline: \'Dashboard Monitoring Biogas Real-time & Predictive Yield Berbasis IoT\',\n    category: \'ai-iot\',\n    categoryLabel: \'IoT & Smart Energy\',\n    awardBadge: {\n      text: \'Juara 1 Nasional\',\n      event: \'KILAT KNEC 2026\',\n      year: \'2026\',\n      isChampion: true,\n    },\n    description: \'Platform terintegrasi pemantauan parameter digester biogas (tekanan, suhu, kadar CH4 & CO2) secara real-time dengan prediksi hasil gas menggunakan sensor telemetri dan kontrol otomatis.\',\n    longDescription: \'AVO-BIO diciptakan untuk menjawab tantangan inefisiensi pengolahan limbah organik menjadi biogas. Sistem ini menghubungkan mikrokontroler ESP32 dengan sensor gas industri melalui protokol MQTT, menyajikan dashboard analitik real-time, serta memberikan peringatan dini (early warning system) jika terjadi anomali tekanan atau suhu digester.\',\n    metrics: [\n      { label: \'Sensor Uptime\', value: \'99.4%\' },\n      { label: \'Efisiensi Produksi Gas\', value: \'+34%\' },\n    ],\n    techStack: [\'ESP32 & Sensors\', \'MQTT Protocol\', \'React.js\', \'Laravel API\', \'Supabase\', \'Tailwind CSS\'],\n    features: [\n      \'Pemantauan sensor CH4, CO2, Suhu, dan Tekanan 24/7\',\n      \'Prediksi volume hasil gas mingguan berbasis data historis\',\n      \'Sistem notifikasi anomali tekanan via Telegram & Webhook\',\n      \'Kalkulator konversi energi ke setara kWh listrik & LPG\',\n    ],\n    architectureSummary: \'Sensor Node (ESP32) \342\236\224 Broker MQTT Mosquitto \342\236\224 Backend Laravel \342\236\224 PostgreSQL/Supabase \342\236\224 Frontend React Real-time Dashboard.\',\n    demoLink: \'#avo-bio-demo\',\n    gradient: {\n      from: \'#6C7CE0\',\n      to: \'#8EA2F8\',\n      accent: \'#6C7CE0\',\n    },\n    interactiveType: \'biogas-telemetry\',\n  },\n  {\n    id: \'panganara-ai\',\n    title: \'PANGANARA AI\',\n    slug: \'panganara-demo\',\n    tagline: \'Platform Digitalisasi & Pelestarian Pangan Tradisional 38 Provinsi\',\n    category: \'web-fullstack\',\n    categoryLabel: \'AI & Heritage Platform\',\n    awardBadge: {\n      text: \'Finalis Inovasi Budaya\',\n      event: \'Pangan Nusantara Tech\',\n      year: \'2026\',\n      isChampion: false,\n    },\n    description: \'Pusat eksplorasi warisan pangan Nusantara dengan peta spasial interaktif 38 provinsi di Indonesia, dilengkapi rekomendasi nutrisi kearifan lokal berbasis AI semantic search.\',\n    longDescription: \'PANGANARA AI mendokumentasikan keanekaragaman kuliner, bahan pangan endemik, serta resep tradisional nusantara yang terancam punah. Mengintegrasikan pencarian semantik AI untuk mencocokkan profil gizi bahan lokal dengan kebutuhan kesehatan modern.\',\n    metrics: [\n      { label: \'Cakupan Wilayah\', value: \'38 Provinsi\' },\n      { label: \'Warisan Terindeks AI\', value: \'420+ Pangan\' },\n    ],\n    techStack: [\'Next.js\', \'Interactive GeoJSON Map\', \'AI Semantic Index\', \'Tailwind CSS\', \'Supabase\'],\n    features: [\n      \'Peta vektor interaktif 38 provinsi Indonesia\',\n      \'Pencarian cerdas bahan pangan lokal berdasarkan kandungan nutrisi & musim panen\',\n      \'Ensiklopedia digital teknik pengawetan fermentasi tradisional\',\n      \'Mode visualisasi hubungan bahan pangan antar kepulauan\',\n    ],\n    architectureSummary: \'GeoJSON Engine \342\236\224 Vector Search AI Model \342\236\224 Next.js Server Actions \342\236\224 Supabase Storage & Relational Data.\',\n    demoLink: \'#panganara-demo\',\n    gradient: {\n      from: \'#B48CE0\',\n      to: \'#D6A8FF\',\n      accent: \'#B48CE0\',\n    },\n    interactiveType: \'pangan-map\',\n  },\n  {\n    id: \'sirkul-ai\',\n    title: \'SIRKUL-AI\',\n    slug: \'sirkul-ai-demo\',\n    tagline: \'Sistem Aerasi Cerdas Bioflok Lele Berbasis IoT, Fuzzy Logic & PLTS\',\n    category: \'ai-iot\',\n    categoryLabel: \'IoT & Smart Aquaculture\',\n    awardBadge: {\n      text: \'Inovasi Agromaritim\',\n      event: \'Smart Farming Expo\',\n      year: \'2026\',\n      isChampion: false,\n    },\n    description: \'Optimasi aerasi dan kualitas air kolam bioflok lele menggunakan algoritma Fuzzy Logic untuk mengatur suplai oksigen terlarut sesuai suhu dan pH air bertenaga panel surya (PLTS).\',\n    longDescription: \'Sistem ini memecahkan masalah pemborosan daya listrik pada aerator bioflok konvensional. Dengan kendali cerdas Fuzzy Logic yang membaca sensor Dissolved Oxygen (DO), suhu, dan amonia, aerator bekerja secara presisi sehingga menghemat konsumsi energi baterai PLTS.\',\n    metrics: [\n      { label: \'Hemat Daya Listrik\', value: \'42%\' },\n      { label: \'Survival Rate Lele\', value: \'>95%\' },\n    ],\n    techStack: [\'ESP32 Dual-Core\', \'Fuzzy Logic Engine\', \'PLTS Solar Monitoring\', \'React\', \'MQTT Client\'],\n    features: [\n      \'Regulasi otomatis kecepatan aerator via Fuzzy Mamdani\',\n      \'Telemetri daya PLTS (Solar panel input, Baterai SoC, Konsumsi inverter)\',\n      \'Deteksi dini penurunan kadar oksigen terlarut (DO < 4 mg/L)\',\n      \'Jadwal pemberian pakan otomatis terkalibrasi nafsu makan lele\',\n    ],\n    architectureSummary: \'Solar Controller + Sensor Node (ESP32) \342\236\224 Fuzzy Logic Microcontroller \342\236\224 MQTT Broker \342\236\224 Web Telemetry Panel.\',\n    demoLink: \'#sirkul-ai-demo\',\n    gradient: {\n      from: \'#6C7CE0\',\n      to: \'#4ECDC4\',\n      accent: \'#6C7CE0\',\n    },\n    interactiveType: \'bioflok-sensors\',\n  },\n  {\n    id: \'sirkular\',\n    title: \'SIRKULAR\',\n    slug: \'sirkular-demo\',\n    tagline: \'Marine Plastic Debris Detection & Maritime Health Monitoring\',\n    category: \'ai-iot\',\n    categoryLabel: \'AI Computer Vision & Ocean\',\n    awardBadge: {\n      text: \'Official Project\',\n      event: \'Friend of The Sea 2026\',\n      year: \'2026\',\n      isChampion: false,\n    },\n    description: \'Sistem klasifikasi citra sampah plastik laut di muara sungai dan pesisir pantai menggunakan model Computer Vision ringan untuk pemetaan titik akumulasi limbah maritim.\',\n    longDescription: \'SIRKULAR memanfaatkan kamera pengawas pesisir dengan model AI deteksi objek yang mampu mengidentifikasi botol plastik, kantong plastik, jaring ikan, dan sampah styrofoam secara real-time untuk memandu tim pembersihan pesisir secara terarah.\',\n    metrics: [\n      { label: \'Akurasi Deteksi AI\', value: \'91.8%\' },\n      { label: \'Kecepatan Inferensi\', value: \'85 ms\' },\n    ],\n    techStack: [\'Python YOLOv8\', \'OpenCV\', \'React Dashboard\', \'FastAPI\', \'Tailwind CSS\'],\n    features: [\n      \'Deteksi multi-kategori sampah permukaan laut secara otomatis\',\n      \'Heatmap sebaran titik kumpul sampah di wilayah perairan\',\n      \'Estimasi berat volume sampah mingguan\',\n      \'Integrasi peringatan tim satgas kebersihan pantai\',\n    ],\n    architectureSummary: \'Edge Camera Feed \342\236\224 YOLOv8 Inference API (FastAPI) \342\236\224 Geo-tagged Incident DB \342\236\224 React Analytics Dashboard.\',\n    demoLink: \'#sirkular-demo\',\n    gradient: {\n      from: \'#4A70E2\',\n      to: \'#7AA2F7\',\n      accent: \'#4A70E2\',\n    },\n    interactiveType: \'ocean-detection\',\n  },\n  {\n    id: \'neraca\',\n    title: \'NERACA\',\n    slug: \'neraca-demo\',\n    tagline: \'Dashboard Prediksi Krisis & Fluktuasi Komoditas Pangan Nasional\',\n    category: \'data-dashboard\',\n    categoryLabel: \'Data Science & Forecasting\',\n    awardBadge: {\n      text: \'Finalis National Hackathon\',\n      event: \'Data for Nation 2026\',\n      year: \'2026\',\n      isChampion: false,\n    },\n    description: \'Sistem analisis time-series dan prediksi pergerakan harga komoditas pangan pokok (beras, cabai, minyak goreng) menggunakan model LSTM untuk mitigasi kerentanan pangan.\',\n    longDescription: \'NERACA mengolah data historis harga pasar, anomali cuaca BMKG, dan volume distribusi antar daerah untuk memprediksi lonjakan harga 30 hari ke depan, memberikan visualisasi tren yang mudah dipahami oleh pengambil kebijakan.\',\n    metrics: [\n      { label: \'Prediksi Horizon\', value: \'30 Hari\' },\n      { label: \'Akurasi Tren Model\', value: \'94.2%\' },\n    ],\n    techStack: [\'LSTM Neural Network\', \'Python Data Pipeline\', \'Supabase\', \'React\', \'Recharts & D3\'],\n    features: [\n      \'Grafik interaktif pergerakan harga komoditas historis vs hasil prediksi\',\n      \'Indeks Kerentanan Pangan Daerah (Food Insecurity Risk Level)\',\n      \'Korelasi anomali curah hujan dengan fluktuasi panen lokal\',\n      \'Export data laporan analitik bulanan (PDF & CSV)\',\n    ],\n    architectureSummary: \'Multi-Source Data Scraper \342\236\224 Python Pipeline + LSTM Model \342\236\224 REST API \342\236\224 Interactive React Recharts Dashboard.\',\n    demoLink: \'#neraca-demo\',\n    gradient: {\n      from: \'#B48CE0\',\n      to: \'#9D6DE3\',\n      accent: \'#B48CE0\',\n    },\n    interactiveType: \'commodity-forecast\',\n  },\n  {\n    id: \'pos-resto\',\n    title: \'POS Resto\',\n    slug: \'pos-resto-demo\',\n    tagline: \'Aplikasi Point of Sale Restoran Full-Stack Modern & Offline-Ready\',\n    category: \'web-fullstack\',\n    categoryLabel: \'Full-Stack Web App\',\n    awardBadge: {\n      text: \'Commercial Build\',\n      event: \'F&B Business Solution\',\n      year: \'2025\',\n      isChampion: false,\n    },\n    description: \'Sistem kasir dan manajemen pesanan meja terintegrasi dengan dapur (Kitchen Display System), inventaris bahan baku otomatis, serta laporan omzet keuangan harian.\',\n    longDescription: \'Dirancang untuk operasional restoran cepat dan andal bahkan saat koneksi internet terputus berkat arsitektur offline-first IndexedDB dengan sinkronisasi otomatis ke cloud Supabase ketika online kembali.\',\n    metrics: [\n      { label: \'Latency Transaksi\', value: \'<50 ms\' },\n      { label: \'Offline Sync Support\', value: \'100%\' },\n    ],\n    techStack: [\'React\', \'TypeScript\', \'Tailwind CSS\', \'IndexedDB Local Cache\', \'Supabase Realtime\'],\n    features: [\n      \'Pemesanan berbasis denah meja (Table Management)\',\n      \'Kitchen Order Ticket (KOT) real-time display\',\n      \'Otomatisasi pemotongan stok bahan baku berdasarkan resep menu\',\n      \'Kalkulasi diskon, pajak, cetak struk thermal, & QRIS static/dynamic\',\n    ],\n    architectureSummary: \'React Frontend \342\236\224 Local IndexedDB Cache \342\236\224 Background Worker Sync \342\236\224 Supabase Database & Auth.\',\n    demoLink: \'#pos-resto-demo\',\n    gradient: {\n      from: \'#5C6BC0\',\n      to: \'#7E57C2\',\n      accent: \'#5C6BC0\',\n    },\n    interactiveType: \'pos-checkout\',\n  },\n];\n\nexport const SKILL_CATEGORIES: SkillCategory[] = [\n  {\n    id: \'web-frontend\',\n    title: \'Frontend & UI Engineering\',\n    description: \'Membangun antarmuka modern, cepat, responsif, dan kaya interaktivitas visual.\',\n    skills: [\n      {\n        name: \'React.js & Next.js\',\n        level: \'Mahir\',\n        iconName: \'Layout\',\n        description: \'Pengembangan Single Page Application (SPA), Server Components, state management, & custom hooks.\',\n        tags: [\'React 18/19\', \'Next.js App Router\', \'Hooks\', \'State Management\'],\n      },\n      {\n        name: \'TypeScript\',\n        level: \'Mahir\',\n        iconName: \'Code2\',\n        description: \'Penulisan kode aman type-safe dengan interface terstruktur dan pola arsitektur bersih.\',\n        tags: [\'Generics\', \'Strict Typing\', \'Interface Design\'],\n      },\n      {\n        name: \'Tailwind CSS & Styling\',\n        level: \'Mahir\',\n        iconName: \'Palette\',\n        description: \'Penerapan atomic CSS, token desain modern, responsive layout, dan animasi transisi halus.\',\n        tags: [\'Responsive Grid\', \'Motion Animation\', \'Design System\'],\n      },\n    ],\n  },\n  {\n    id: \'ai-ml\',\n    title: \'AI, Machine Learning & Algoritma\',\n    description: \'Penerapan model kecerdasan buatan, logika fuzzy, dan analisis data cerdas.\',\n    skills: [\n      {\n        name: \'AI & Machine Learning (LSTM)\',\n        level: \'Menengah\',\n        iconName: \'BrainCircuit\',\n        description: \'Pemodelan time-series forecasting, regresi harga komoditas, dan evaluasi metrik akurasi.\',\n        tags: [\'LSTM\', \'Time-Series\', \'Model Training\', \'Scikit-Learn\'],\n      },\n      {\n        name: \'Fuzzy Logic System\',\n        level: \'Mahir\',\n        iconName: \'Cpu\',\n        description: \'Perancangan rule base Fuzzy Mamdani/Sugeno untuk kontrol aerasi dinamis dan aktuasi otomatis.\',\n        tags: [\'Mamdani Logic\', \'Membership Function\', \'Actuator Control\'],\n      },\n      {\n        name: \'Computer Vision Basics\',\n        level: \'Menengah\',\n        iconName: \'Scan\',\n        description: \'Deteksi objek sampah pesisir dan pengolahan citra digital untuk monitoring lingkungan.\',\n        tags: [\'YOLO Detection\', \'OpenCV\', \'Image Processing\'],\n      },\n    ],\n  },\n  {\n    id: \'iot-embedded\',\n    title: \'IoT & Embedded Hardware\',\n    description: \'Integrasi sensor fisik, mikrokontroler, dan protokol komunikasi data telemetri.\',\n    skills: [\n      {\n        name: \'ESP32 & Sensors\',\n        level: \'Mahir\',\n        iconName: \'Microchip\',\n        description: \'Pemrograman mikrokontroler dual-core, pembacaan sensor analog/digital (MQ-4, DO, pH, DS18B20).\',\n        tags: [\'ESP32\', \'GPIO & ADC\', \'I2C/SPI\', \'Energy Management\'],\n      },\n      {\n        name: \'MQTT Protocol\',\n        level: \'Mahir\',\n        iconName: \'Radio\',\n        description: \'Komunikasi publish/subscribe berlatensi rendah untuk pertukaran data telemetri IoT ke server.\',\n        tags: [\'Mosquitto\', \'Pub/Sub\', \'QoS 0/1/2\', \'Payload JSON\'],\n      },\n      {\n        name: \'Solar Telemetry (PLTS)\',\n        level: \'Menengah\',\n        iconName: \'Zap\',\n        description: \'Monitoring sistem catu daya mandiri bertenaga panel surya, status baterai & proteksi beban.\',\n        tags: [\'Solar Charge Controller\', \'Battery Health\', \'Inverter Sensing\'],\n      },\n    ],\n  },\n  {\n    id: \'backend-database\',\n    title: \'Backend, Database & Visualisasi\',\n    description: \'Pengelolaan basis data relasional, REST API, dan penyajian grafik analitik.\',\n    skills: [\n      {\n        name: \'Laravel & REST API\',\n        level: \'Menengah\',\n        iconName: \'Server\',\n        description: \'Arsitektur MVC, Eloquent ORM, autentikasi aman, dan manajemen endpoint API data.\',\n        tags: [\'Laravel\', \'RESTful API\', \'Sanctum Auth\', \'Middleware\'],\n      },\n      {\n        name: \'Database (Supabase & SQL)\',\n        level: \'Mahir\',\n        iconName: \'Database\',\n        description: \'Desain skema relasional, PostgreSQL queries, Realtime subscriptions, dan Row Level Security (RLS).\',\n        tags: [\'Supabase\', \'PostgreSQL\', \'Relational Schemas\', \'Realtime Sync\'],\n      },\n      {\n        name: \'Data Visualization (D3 & Recharts)\',\n        level: \'Mahir\',\n        iconName: \'BarChart3\',\n        description: \'Visualisasi grafik telemetri, tren harga, peta spasial geografis, dan indikator status.\',\n        tags: [\'Recharts\', \'Interactive Charts\', \'Telemetry Gauges\', \'GIS Map\'],\n      },\n    ],\n  },\n];\n\nexport const TIMELINE: TimelineItem[] = [\n  {\n    id: \'wastukancana\',\n    period: \'2025 \342\200\223 Sekarang\',\n    title: \'Mahasiswa S1 Teknik Informatika\',\n    organization: \'STT Wastukancana Purwakarta\',\n    roleType: \'education\',\n    location: \'Purwakarta, Jawa Barat\',\n    description: \'Menempuh studi sarjana Informatika dengan konsentrasi pada Rekayasa Perangkat Lunak, Sistem Cerdas (AI), dan Internet of Things (IoT). Aktif dalam riset dan kompetisi karya tulis inovasi teknologi tingkat nasional.\',\n    highlights: [\n      \'Fokus riset terapan: Sistem monitoring IoT energi terbarukan & aplikasi kecerdasan buatan untuk pangan.\',\n      \'Mempertahankan reputasi akademis unggul dengan kedisiplinan dan keterlibatan aktif dalam proyek riset kampus.\',\n    ],\n    badge: \'Pendidikan Tinggi\',\n  },\n  {\n    id: \'juara-knec\',\n    period: \'2026\',\n    title: \'Juara 1 Lomba Inovasi KILAT KNEC 2026\',\n    organization: \'Komite Nasional Ekonomi & Keuangan Syariah / KNEC\',\n    roleType: \'achievement\',\n    location: \'Tingkat Nasional\',\n    description: \'Meraih penghargaan Juara 1 tingkat nasional melalui proyek AVO-BIO (Sistem Cerdas Telemetri & Prediksi Biogas Terintegrasi) sebagai inovasi energi hijau berdaya saing tinggi.\',\n    highlights: [\n      \'Membangun prototipe hardware IoT dan web dashboard monitoring real-time yang diuji langsung di hadapan dewan juri.\',\n      \'Mendapatkan apresiasi untuk ketajaman metodologi pemecahan masalah dan dampak ekonomis bagi masyarakat peternak.\',\n    ],\n    badge: \'Prestasi Juara 1\',\n  },\n  {\n    id: \'mpk-ketua\',\n    period: \'Masa Bakti Periode SMA\',\n    title: \'Ketua Komisi A MPK SMA\',\n    organization: \'Majelis Perwakilan Kelas (MPK)\',\n    roleType: \'organization\',\n    location: \'Jawa Barat\',\n    description: \'Memimpin Komisi A yang membidangi legislasi, pengawasan kedisiplinan organisasi siswa, serta penyaluran aspirasi seluruh perwakilan kelas kepada jajaran sekolah.\',\n    highlights: [\n      \'Memimpin sidang pleno penyusunan anggaran dasar dan garis besar program kerja tahunan OSIS/MPK.\',\n      \'Melatih kemampuan kepemimpinan (leadership), diplomasi, mediasi konflik, dan akuntabilitas tata kelola organisasi.\',\n      \'Membangun karakter disiplin waktu, tanggung jawab tinggi, dan kemampuan berkolaborasi dalam tim.\',\n    ],\n    badge: \'Kepemimpinan & Organisasi\',\n  },\n  {\n    id: \'friend-of-the-sea\',\n    period: \'2026\',\n    title: \'Inovator Delegasi Friend of The Sea 2026\',\n    organization: \'Inisiatif Konservasi Kelautan Maritim\',\n    roleType: \'achievement\',\n    location: \'Kolaborasi Proyek\',\n    description: \'Mengembangkan sistem SIRKULAR untuk pendeteksian sampah plastik muara sungai dengan kecerdasan buatan, mendukung keberlanjutan ekosistem laut.\',\n    highlights: [\n      \'Implementasi model Computer Vision ringan yang mampu bekerja di perangkat komputasi tepi pantai.\',\n    ],\n    badge: \'Inisiatif Maritim\',\n  },\n];\n"
    }
