    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Project, SkillCategory, TimelineItem } from \'../types\';\n\nexport const PERSONAL_INFO = {\n  name: \'Farid Nadir Amrulloh\',\n  shortName: \'Farid Nadir\',\n  title: \'Mahasiswa Teknik Informatika, STT Wastukancana Purwakarta\',\n  university: \'STT Wastukancana Purwakarta\',\n  period: \'2025 \342\200\223 Sekarang\',\n  location: \'Purwakarta, Jawa Barat, Indonesia\',\n  email: \'faridnadir24@gmail.com\',\n  whatsappNumber: \'6281902716562\',\n  whatsappDisplay: \'081902716562\',\n  whatsappUrl: \'https://wa.me/6281902716562\',\n  githubUrl: \'https://github.com/faridnadir24-bit\',\n  githubDisplay: \'github.com/faridnadir24-bit\',\n  linkedinUrl: \'https://www.linkedin.com/in/farid-nadir-amrulloh-149290360/\',\n  tagline: \'Membangun solusi perangkat lunak berbasis AI, IoT, dan analisis data cerdas dengan integritas, disiplin, dan dampak nyata.\',\n  bio: \'Mahasiswa Teknik Informatika di STT Wastukancana yang berdedikasi merancang dan mengembangkan sistem komputasi terapan \342\200\224 memadukan rekayasa perangkat lunak dengan kecerdasan buatan (AI) dan IoT untuk isu energi terbarukan, pangan, dan lingkungan. Aktif di organisasi kemahasiswaan (GMNI) dan kegiatan sosial kemasyarakatan.\',\n  status: \'Terbuka untuk Kolaborasi Riset & Proyek Teknologi\',\n};\n\nexport const PROJECTS: Project[] = [\n  {\n    id: \'avo-bio\',\n    title: \'AVO-BIO\',\n    slug: \'avo-bio-demo\',\n    tagline: \'Dashboard Monitoring Biogas Real-time & Prediksi Hasil (IoT + AI)\',\n    category: \'ai-iot\',\n    categoryLabel: \'IoT & Smart Energy\',\n    awardBadge: {\n      text: \'Juara 1 Nasional\',\n      event: \'Kilat National Essay Competition (KNEC) 2026\',\n      year: \'2026\',\n      isChampion: true,\n    },\n    description: \'Dashboard monitoring biogas real-time dan prediksi hasil gas menggunakan integrasi IoT, sensor telemetri, serta model analitik cerdas untuk ketahanan pangan & energi.\',\n    longDescription: \'AVO-BIO merupakan solusi komputasi terapan yang memenangkan Juara 1 Nasional KNEC 2026 (subtema Ketahanan Pangan & Energi). Sistem ini mengintegrasikan sensor gas industri ke mikrokontroler ESP32 via protokol MQTT, menyajikan dashboard analitik real-time, serta memberikan prediksi volume gas dan deteksi anomali digester.\',\n    metrics: [\n      { label: \'Sensor Uptime\', value: \'99.4%\' },\n      { label: \'Efisiensi Produksi Gas\', value: \'+34%\' },\n    ],\n    techStack: [\'ESP32\', \'MQTT\', \'React.js\', \'Laravel API\', \'Supabase\'],\n    features: [\n      \'Pemantauan sensor CH4, CO2, Suhu, dan Tekanan 24/7 secara real-time\',\n      \'Prediksi volume hasil gas mingguan berbasis data telemetri historis\',\n      \'Sistem peringatan dini (early warning) anomali tekanan & suhu digester\',\n      \'Kalkulator konversi energi ke setara kWh listrik & tabung LPG\',\n    ],\n    architectureSummary: \'Sensor Node (ESP32) \342\236\224 Broker MQTT \342\236\224 Backend Laravel REST API \342\236\224 Database Supabase \342\236\224 React.js Real-time Dashboard.\',\n    demoLink: \'#avo-bio-demo\',\n    gradient: {\n      from: \'#6C7CE0\',\n      to: \'#8EA2F8\',\n      accent: \'#6C7CE0\',\n    },\n    interactiveType: \'biogas-telemetry\',\n  },\n  {\n    id: \'panganara-ai\',\n    title: \'PANGANARA AI\',\n    slug: \'panganara-demo\',\n    tagline: \'Platform Digitalisasi & Pelestarian Pangan Tradisional 38 Provinsi Indonesia\',\n    category: \'web-fullstack\',\n    categoryLabel: \'AI & Heritage Platform\',\n    awardBadge: {\n      text: \'Finalis Inovasi Budaya\',\n      event: \'Pelestarian Pangan Nusantara\',\n      year: \'2026\',\n      isChampion: false,\n    },\n    description: \'Platform digitalisasi dan pelestarian pangan tradisional 38 provinsi di Indonesia yang dilengkapi peta spasial interaktif serta AI semantic search rekomendasi nutrisi kearifan lokal.\',\n    longDescription: \'PANGANARA AI mendokumentasikan keanekaragaman kuliner, bahan pangan endemik, serta resep tradisional nusantara. Mengintegrasikan pencarian semantik AI untuk menelusuri profil gizi bahan lokal serta memvisualisasikan persebaran kuliner berbasis peta interaktif GeoJSON.\',\n    metrics: [\n      { label: \'Cakupan Wilayah\', value: \'38 Provinsi\' },\n      { label: \'Warisan Terindeks AI\', value: \'420+ Pangan\' },\n    ],\n    techStack: [\'Next.js\', \'GeoJSON Map\', \'AI Semantic Index\', \'Supabase\'],\n    features: [\n      \'Peta spasial interaktif 38 provinsi di Indonesia dengan GeoJSON\',\n      \'Pencarian cerdas berbasis AI Semantic Search untuk resep & bahan pangan lokal\',\n      \'Ensiklopedia digital teknik pengolahan & fermentasi pangan tradisional\',\n      \'Visualisasi profil nutrisi komparatif antar wilayah kepulauan\',\n    ],\n    architectureSummary: \'Next.js Frontend \342\236\224 Peta GeoJSON Interaktif \342\236\224 Vector Search AI Model \342\236\224 Supabase Storage & Relational Data.\',\n    demoLink: \'#panganara-demo\',\n    gradient: {\n      from: \'#B48CE0\',\n      to: \'#D6A8FF\',\n      accent: \'#B48CE0\',\n    },\n    interactiveType: \'pangan-map\',\n  },\n  {\n    id: \'sirkular\',\n    title: \'SIRKULAR\',\n    slug: \'sirkular-demo\',\n    tagline: \'Deteksi Sampah Plastik Laut di Muara Sungai/Pesisir Pakai Computer Vision\',\n    category: \'ai-iot\',\n    categoryLabel: \'AI Computer Vision & Ocean\',\n    awardBadge: {\n      text: \'Official Project\',\n      event: \'Friend of The Sea 2026\',\n      year: \'2026\',\n      isChampion: false,\n    },\n    description: \'Sistem deteksi sampah plastik laut di muara sungai dan pesisir menggunakan Computer Vision YOLOv8 ringan untuk pemetaan titik akumulasi limbah maritim.\',\n    longDescription: \'SIRKULAR memanfaatkan kamera pengawas pesisir dengan model AI deteksi objek yang mampu mengidentifikasi botol plastik, kantong plastik, jaring ikan, dan sampah styrofoam secara real-time untuk memandu aksi pembersihan pesisir pantai secara efektif.\',\n    metrics: [\n      { label: \'Akurasi Deteksi AI\', value: \'91.8%\' },\n      { label: \'Kecepatan Inferensi\', value: \'85 ms\' },\n    ],\n    techStack: [\'Python YOLOv8\', \'OpenCV\', \'FastAPI\', \'React Dashboard\'],\n    features: [\n      \'Deteksi multi-kategori sampah plastik permukaan air secara real-time\',\n      \'Heatmap sebaran titik akumulasi limbah di muara sungai & pesisir pantai\',\n      \'Estimasi berat dan volume sampah berkala\',\n      \'Dashboard analitik terintegrasi FastAPI & React untuk pemantauan tim konservasi\',\n    ],\n    architectureSummary: \'Edge Camera Feed \342\236\224 Python YOLOv8 + OpenCV \342\236\224 FastAPI Backend \342\236\224 React Monitoring Dashboard.\',\n    demoLink: \'#sirkular-demo\',\n    gradient: {\n      from: \'#4A70E2\',\n      to: \'#7AA2F7\',\n      accent: \'#4A70E2\',\n    },\n    interactiveType: \'ocean-detection\',\n  },\n  {\n    id: \'neraca\',\n    title: \'NERACA\',\n    slug: \'neraca-demo\',\n    tagline: \'Dashboard Prediksi & Peringatan Dini Krisis Pangan Berbasis Neraca Massa Air & AI\',\n    category: \'data-dashboard\',\n    categoryLabel: \'Data Science & Forecasting\',\n    awardBadge: {\n      text: \'Lampiran Esai Kompetisi\',\n      event: \'SEC 2026\',\n      year: \'2026\',\n      isChampion: false,\n    },\n    description: \'Dashboard prediksi dan sistem peringatan dini krisis pangan nasional berbasis neraca massa air dan model AI time-series LSTM (lampiran esai kompetisi SEC 2026).\',\n    longDescription: \'NERACA dirancang sebagai lampiran esai kompetisi SEC 2026. Mengolah data neraca massa air, indikator iklim BMKG, dan dinamika rantai pasok pangan untuk memproyeksikan kerentanan pangan dan lonjakan harga pangan pokok menggunakan pemodelan LSTM cerdas.\',\n    metrics: [\n      { label: \'Prediksi Horizon\', value: \'30 Hari\' },\n      { label: \'Akurasi Tren Model\', value: \'94.2%\' },\n    ],\n    techStack: [\'Python\', \'LSTM/pipeline data\', \'Supabase\', \'React\', \'Recharts/D3\'],\n    features: [\n      \'Simulasi neraca massa air dan dampaknya terhadap produktivitas panen\',\n      \'Pemodelan prediksi harga komoditas pangan pokok 30 hari ke depan dengan LSTM\',\n      \'Sistem peringatan dini indeks kerentanan pangan daerah\',\n      \'Grafik visualisasi interaktif multi-dimensi dengan Recharts & D3\',\n    ],\n    architectureSummary: \'Python Data Pipeline \342\236\224 Pemodelan LSTM Neraca Massa Air \342\236\224 Supabase DB \342\236\224 React & Recharts/D3 Dashboard.\',\n    demoLink: \'#neraca-demo\',\n    gradient: {\n      from: \'#B48CE0\',\n      to: \'#9D6DE3\',\n      accent: \'#B48CE0\',\n    },\n    interactiveType: \'commodity-forecast\',\n  },\n  {\n    id: \'pos-resto\',\n    title: \'POS Resto\',\n    slug: \'pos-resto-demo\',\n    tagline: \'Aplikasi Kasir Restoran Full-Stack Offline-Ready dengan Kitchen Display System\',\n    category: \'web-fullstack\',\n    categoryLabel: \'F&B Business Solution\',\n    awardBadge: {\n      text: \'Commercial Build\',\n      event: \'F&B Business Solution 2025\',\n      year: \'2025\',\n      isChampion: false,\n    },\n    description: \'Aplikasi kasir restoran full-stack modern dengan kemampuan offline-ready IndexedDB, sinkronisasi realtime, manajemen denah meja, dan Kitchen Display System.\',\n    longDescription: \'Solusi perangkat lunak point-of-sale komersial yang dirancang untuk operasional F&B yang cepat dan reliabel. Tetap dapat beroperasi penuh tanpa koneksi internet berkat IndexedDB lokal dan melakukan sinkronisasi otomatis ke Supabase Realtime ketika online kembali.\',\n    metrics: [\n      { label: \'Latency Transaksi\', value: \'<50 ms\' },\n      { label: \'Offline Sync Support\', value: \'100%\' },\n    ],\n    techStack: [\'React\', \'TypeScript\', \'IndexedDB\', \'Supabase Realtime\'],\n    features: [\n      \'Manajemen denah meja interaktif (Table Layout Management)\',\n      \'Kitchen Display System (KDS) & Kitchen Order Ticket (KOT) real-time\',\n      \'Penyimpanan transaksi lokal offline-ready dengan IndexedDB & auto-sync cloud\',\n      \'Kalkulasi omzet harian, diskon, cetak struk thermal, dan QRIS\',\n    ],\n    architectureSummary: \'React + TypeScript \342\236\224 IndexedDB Local Storage \342\236\224 Background Sync Worker \342\236\224 Supabase Realtime Cloud DB.\',\n    demoLink: \'#pos-resto-demo\',\n    gradient: {\n      from: \'#5C6BC0\',\n      to: \'#7E57C2\',\n      accent: \'#5C6BC0\',\n    },\n    interactiveType: \'pos-checkout\',\n  },\n];\n\nexport const SKILL_CATEGORIES: SkillCategory[] = [\n  {\n    id: \'web-frontend\',\n    title: \'Frontend & UI Engineering\',\n    description: \'Pengembangan antarmuka web modern, responsif, cepat, dan komponen interaktif berkinerja tinggi.\',\n    skills: [\n      {\n        name: \'React.js / Next.js\',\n        level: \'Mahir\',\n        iconName: \'Layout\',\n        description: \'Single Page Application (SPA), Server Components, state management hooks, dan routing modern.\',\n        tags: [\'React.js\', \'Next.js\', \'Hooks\', \'State Management\'],\n      },\n      {\n        name: \'TypeScript\',\n        level: \'Mahir\',\n        iconName: \'Code2\',\n        description: \'Penulisan kode aman type-safe dengan interface terstruktur dan clean code architecture.\',\n        tags: [\'TypeScript\', \'Strict Types\', \'Interface & Generics\'],\n      },\n      {\n        name: \'Tailwind CSS\',\n        level: \'Mahir\',\n        iconName: \'Palette\',\n        description: \'Penerapan utility-first styling, desain responsif mobile-to-desktop, dan transisi visual elegan.\',\n        tags: [\'Tailwind CSS\', \'Responsive Grid\', \'Design Systems\'],\n      },\n    ],\n  },\n  {\n    id: \'ai-ml\',\n    title: \'AI, Machine Learning & Algoritma\',\n    description: \'Penerapan model kecerdasan buatan, peramalan data deret waktu, logika adaptif, dan visi komputer.\',\n    skills: [\n      {\n        name: \'LSTM (Long Short-Term Memory)\',\n        level: \'Menengah\',\n        iconName: \'BrainCircuit\',\n        description: \'Pemodelan time-series forecasting untuk peramalan harga komoditas dan tren data sensor.\',\n        tags: [\'LSTM\', \'Time-Series\', \'Model Training\', \'Forecasting\'],\n      },\n      {\n        name: \'Fuzzy Logic\',\n        level: \'Mahir\',\n        iconName: \'Cpu\',\n        description: \'Perancangan rule-base Fuzzy Mamdani/Sugeno untuk sistem kendali aktuator dan telemetri adaptif.\',\n        tags: [\'Fuzzy Logic\', \'Mamdani\', \'Decision Rules\', \'Actuator Control\'],\n      },\n      {\n        name: \'Computer Vision Dasar\',\n        level: \'Menengah\',\n        iconName: \'Scan\',\n        description: \'Deteksi objek sampah pesisir dan pemrosesan citra digital dengan arsitektur ringan.\',\n        tags: [\'Computer Vision\', \'YOLOv8\', \'OpenCV\', \'Image Processing\'],\n      },\n    ],\n  },\n  {\n    id: \'iot-embedded\',\n    title: \'IoT & Embedded Hardware\',\n    description: \'Integrasi sensor fisik, mikrokontroler terprogram, dan protokol transmisi data telemetri.\',\n    skills: [\n      {\n        name: \'ESP32 & Sensors\',\n        level: \'Mahir\',\n        iconName: \'Microchip\',\n        description: \'Pemrograman mikrokontroler ESP32, interaksi sensor analog/digital (suhu, tekanan, gas, pH, DO).\',\n        tags: [\'ESP32\', \'Sensors Integration\', \'ADC/GPIO\', \'Embedded C++\'],\n      },\n      {\n        name: \'MQTT\',\n        level: \'Mahir\',\n        iconName: \'Radio\',\n        description: \'Komunikasi publish/subscribe berlatensi rendah untuk streaming data telemetri IoT ke cloud/server.\',\n        tags: [\'MQTT Protocol\', \'Pub/Sub\', \'Mosquitto Broker\', \'Payload Telemetry\'],\n      },\n      {\n        name: \'Solar Telemetry (PLTS)\',\n        level: \'Menengah\',\n        iconName: \'Zap\',\n        description: \'Monitoring sistem catu daya panel surya mandiri, efisiensi konversi daya baterai, dan sensing beban.\',\n        tags: [\'Solar Telemetry\', \'PLTS Monitoring\', \'Battery Health\', \'Energy Sensing\'],\n      },\n    ],\n  },\n  {\n    id: \'backend-database\',\n    title: \'Backend, Database & Visualisasi\',\n    description: \'Pengelolaan basis data relasional, perancangan API backend, dan dashboard visualisasi interaktif.\',\n    skills: [\n      {\n        name: \'Laravel & REST API\',\n        level: \'Menengah\',\n        iconName: \'Server\',\n        description: \'Arsitektur MVC, pembuatan endpoint RESTful API yang aman, middleware, dan manipulasi data.\',\n        tags: [\'Laravel\', \'REST API\', \'Sanctum Auth\', \'Routing & Middleware\'],\n      },\n      {\n        name: \'Supabase / PostgreSQL\',\n        level: \'Mahir\',\n        iconName: \'Database\',\n        description: \'Perancangan skema relasional, SQL queries, Row Level Security (RLS), dan Realtime subscription.\',\n        tags: [\'Supabase\', \'PostgreSQL\', \'Relational Schemas\', \'Realtime Sync\'],\n      },\n      {\n        name: \'D3 / Recharts\',\n        level: \'Mahir\',\n        iconName: \'BarChart3\',\n        description: \'Pembuatan visualisasi data interaktif: grafik deret waktu, indikator metrik, dan peta spasial.\',\n        tags: [\'D3.js\', \'Recharts\', \'Interactive Charts\', \'Data Visuals\'],\n      },\n    ],\n  },\n];\n\nexport const TIMELINE: TimelineItem[] = [\n  {\n    id: \'wastukancana\',\n    period: \'2025 \342\200\223 Sekarang\',\n    title: \'Mahasiswa S1 Teknik Informatika\',\n    organization: \'STT Wastukancana Purwakarta\',\n    roleType: \'education\',\n    location: \'Purwakarta, Jawa Barat\',\n    description: \'Menempuh studi sarjana Teknik Informatika dengan fokus pada rekayasa perangkat lunak terapan, sistem kecerdasan buatan (AI), dan sistem tertanam Internet of Things (IoT). Berkomitmen memadukan kedisiplinan riset akademik dengan karya nyata yang berdampak pada energi, pangan, dan lingkungan.\',\n    highlights: [\n      \'Fokus studi & riset: AI Time-Series (LSTM), Telemetri IoT ESP32, dan arsitektur Full-Stack modern.\',\n      \'Aktif mewakili kampus dalam kompetisi inovasi ilmiah dan rekayasa teknologi tingkat nasional.\',\n    ],\n    badge: \'Pendidikan Tinggi\',\n  },\n  {\n    id: \'gmni-wastukancana\',\n    period: \'Agustus 2026 \342\200\223 Sekarang\',\n    title: \'Wakil Ketua Bidang Sosial Politik\',\n    organization: \'GMNI Wastukancana Purwakarta\',\n    roleType: \'organization\',\n    location: \'Purwakarta, Jawa Barat\',\n    description: \'Menjabat sebagai pimpinan bidang sosial politik pada organisasi gerakan mahasiswa, mengoordinasikan advokasi kemasyarakatan, analisis kebijakan strategis, serta penanaman nilai integritas dan kepemimpinan progresif.\',\n    highlights: [\n      \'Memimpin perumusan sikap organisasi terhadap isu-isu sosial kemasyarakatan dan kemahasiswaan daerah.\',\n      \'Mengorganisasi kajian ilmiah dan program advokasi publik yang berpihak pada kesejahteraan rakyat.\',\n    ],\n    badge: \'Kepemimpinan Mahasiswa\',\n  },\n  {\n    id: \'juara-knec-2026\',\n    period: \'2026\',\n    title: \'Juara 1 \342\200\224 Kilat National Essay Competition (KNEC) 2026\',\n    organization: \'Komite Nasional Ekonomi & Keuangan Syariah (KNEKS)\',\n    roleType: \'achievement\',\n    location: \'Tingkat Nasional\',\n    description: \'Meraih gelar Juara 1 Nasional pada ajang bergengsi Kilat National Essay Competition (KNEC) 2026 subtema Ketahanan Pangan & Energi melalui karya inovasi sistem pemantauan biogas cerdas AVO-BIO.\',\n    highlights: [\n      \'Merancang sistem telemetri IoT berbasis ESP32 dan dashboard monitoring real-time terintegrasi AI.\',\n      \'Mempresentasikan solusi komputasi yang terbukti meningkatkan efisiensi produksi biogas hingga +34%.\',\n    ],\n    badge: \'Prestasi Juara 1 Nasional\',\n  },\n  {\n    id: \'top-10-leon-2026\',\n    period: \'2026\',\n    title: \'Top 10 Besar \342\200\224 Lomba Esai Online Nasional (LEON) 2026\',\n    organization: \'FORCEMI (Forum Riset & Cendekia Muda Indonesia)\',\n    roleType: \'achievement\',\n    location: \'Tingkat Nasional\',\n    description: \'Meraih predikat Top 10 Besar Nasional pada Lomba Esai Online Nasional (LEON) 2026 subtema Aplikasi & Rekayasa Teknologi yang diselenggarakan oleh FORCEMI sebagai wujud dedikasi dalam perancangan ide teknologi aplikatif.\',\n    highlights: [\n      \'Pencapaian mandiri dalam kompetisi gagasan dan naskah rekayasa teknologi nasional.\',\n      \'Mendapatkan evaluasi tinggi dari tim juri akademisi untuk orisinalitas metodologi dan kelayakan implementasi.\',\n    ],\n    badge: \'Penghargaan Nasional\',\n  },\n  {\n    id: \'pasundan-run-2026\',\n    period: \'Agustus 2026\',\n    title: \'Volunteer Divisi Acara \342\200\224 Pasundan Run 2026 (Run for Unity)\',\n    organization: \'Panitia Pelaksana Pasundan Run 2026\',\n    roleType: \'organization\',\n    location: \'Jawa Barat\',\n    description: \'Berperan aktif sebagai relawan divisi acara dalam perhelatan olahraga lari massal Pasundan Run 2026 (Run for Unity), bertanggung jawab atas manajemen rute, koordinasi panggung, dan kelancaran flow ratusan peserta.\',\n    highlights: [\n      \'Mengelola koordinasi teknis panggung utama dan titik pos rute lintasan lari.\',\n      \'Melatih kemampuan kerja sama tim lintas komunitas, adaptasi situasi cepat, dan manajemen massa.\',\n    ],\n    badge: \'Relawan & Kepanitiaan\',\n  },\n  {\n    id: \'novo-social-2026\',\n    period: \'Agustus 2026\',\n    title: \'Partisipan Kegiatan Sosial \"Cegah Aksi Pelecehan Seksual Bersama NOVO\"\',\n    organization: \'Inisiatif NOVO Edukasi Sosial\',\n    roleType: \'organization\',\n    location: \'SDN 2 Pasirlangu\',\n    description: \'Mengikuti dan berkontribusi langsung dalam program edukasi sosial kemasyarakatan perlindungan anak dan pencegahan pelecehan seksual bagi siswa sekolah dasar di SDN 2 Pasirlangu.\',\n    highlights: [\n      \'Turut memfasilitasi sesi interaktif penyuluhan batasan diri dan keberanian bersuara bagi siswa usia dini.\',\n      \'Mewujudkan kepedulian nyata mahasiswa terhadap isu perlindungan generasi muda dan ketahanan sosial.\',\n    ],\n    badge: \'Aksi Sosial Kemasyarakatan\',\n  },\n  {\n    id: \'mpk-ketua-bungursari\',\n    period: \'Masa Bakti Periode SMA\',\n    title: \'Ketua Komisi A, Majelis Perwakilan Kelas (MPK)\',\n    organization: \'SMA Negeri 1 Bungursari\',\n    roleType: \'organization\',\n    location: \'Bungursari, Purwakarta\',\n    description: \'Memimpin Komisi A MPK SMA Negeri 1 Bungursari yang membidangi fungsi legislasi siswa, pengawasan tata tertib dan disiplin organisasi, serta mediasi penyaluran aspirasi siswa kepada pihak pimpinan sekolah.\',\n    highlights: [\n      \'Memimpin sidang pleno penyusunan tata tertib dan evaluasi program kerja OSIS/MPK.\',\n      \'Membangun fondasi kepemimpinan berintegritas, diplomasi organisasi, serta manajemen waktu yang disiplin.\',\n    ],\n    badge: \'Kepemimpinan Sekolah\',\n  },\n];\n"
    }
