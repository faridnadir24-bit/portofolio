  file_change {
    absolute_path_uri: "file:///src/components/About.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "            {/* Main Story Narrative */}\n            <div className=\"lg:col-span-7 bg-white rounded-2xl p-6 sm:p-8 border border-stone-200/90 shadow-xs space-y-4 text-left\">\n              <h3 className=\"font-serif font-bold text-xl text-[#2A2A3C] flex items-center gap-2\">\n                <span className=\"w-2 h-5 rounded-full bg-[#6C7CE0]\"></span>\n                Dedikasi Rekayasa Perangkat Lunak & Inovasi Cerdas\n              </h3>\n              \n              <p className=\"text-sm sm:text-base text-[#4A4A62] leading-relaxed\">\n                Sebagai mahasiswa Teknik Informatika di <strong>STT Wastukancana</strong> (2025\342\200\223Sekarang), saya memadukan pemahaman teori komputasi dengan implementasi praktis di lapangan. Saya memiliki ketertarikan mendalam dalam merancang sistem yang menghubungkan <em>dunia fisik</em> (melalui sensor IoT dan telemetri hardware) dengan <em>dunia komputasi cerdas</em> (Machine Learning, Fuzzy Logic, dan dashboard analitik real-time).\n              </p>\n\n              <p className=\"text-sm sm:text-base text-[#4A4A62] leading-relaxed\">\n                Karakter saya dibentuk oleh kedisiplinan dan tanggung jawab tinggi. Pengalaman memimpin <strong>Komisi A MPK SMA</strong> (Majelis Perwakilan Kelas) membekali saya dengan integritas tata kelola, kemampuan diplomasi, manajemen waktu yang ketat, serta kebiasaan berpikir terstruktur dalam menyelesaikan masalah rumit.\n              </p>\n\n              {/* Quote Box */}\n              <div className=\"p-4 rounded-xl bg-[#FDF9F3] border-l-3 border-[#6C7CE0] text-sm text-[#2A2A3C] font-medium italic mt-4\">\n                \"Teknologi terbaik bukan sekadar baris kode yang elegan, melainkan sistem yang handal, dapat dipertanggungjawabkan, dan memberikan efisiensi nyata bagi masyarakat.\"\n              </div>\n\n              {/* Highlights List */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\">\n                <div className=\"flex items-start gap-2.5\">\n                  <CheckCircle className=\"w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" />\n                  <span className=\"text-xs sm:text-sm text-[#4A4A62]\">\n                    Berpengalaman dalam kompetisi inovasi tingkat nasional (Juara 1 KILAT KNEC 2026).\n                  </span>\n                </div>\n                <div className=\"flex items-start gap-2.5\">\n                  <CheckCircle className=\"w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" />\n                  <span className=\"text-xs sm:text-sm text-[#4A4A62]\">\n                    Fokus pada sistem nyata: Energi Terbarukan, Bioflok, dan Prediksi Pangan.\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Quick Fact / Academics Card */}\n            <div className=\"lg:col-span-5 space-y-4\">\n              <div className=\"bg-white rounded-2xl p-6 border border-stone-200/90 shadow-xs text-left\">\n                <div className=\"flex items-center gap-3 mb-4\">\n                  <div className=\"w-10 h-10 rounded-xl bg-[#6C7CE0]/10 flex items-center justify-center text-[#6C7CE0]\">\n                    <GraduationCap className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <h4 className=\"font-serif font-bold text-base text-[#2A2A3C]\">STT Wastukancana</h4>\n                    <p className=\"text-xs text-[#5A5A72]\">Teknik Informatika \342\200\242 Angkatan 2025</p>\n                  </div>\n                </div>\n                \n                <ul className=\"space-y-2.5 text-xs text-[#4A4A62] border-t border-stone-100 pt-3\">\n                  <li className=\"flex items-center justify-between\">\n                    <span className=\"text-[#6A6A82]\">Lokasi Kampus:</span>\n                    <span className=\"font-medium text-[#2A2A3C]\">Purwakarta, Jawa Barat</span>\n                  </li>\n                  <li className=\"flex items-center justify-between\">\n                    <span className=\"text-[#6A6A82]\">Minat Utama:</span>\n                    <span className=\"font-medium text-[#2A2A3C]\">Sistem Cerdas & IoT Terapan</span>\n                  </li>\n                  <li className=\"flex items-center justify-between\">\n                    <span className=\"text-[#6A6A82]\">Status Akademik:</span>\n                    <span className=\"font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md\">Aktif Mahasiswa</span>\n                  </li>\n                </ul>\n              </div>\n\n              <div className=\"bg-gradient-to-br from-[#6C7CE0]/8 via-[#B48CE0]/8 to-white rounded-2xl p-6 border border-[#6C7CE0]/20 shadow-xs text-left\">\n                <div className=\"flex items-center gap-2 mb-2\">\n                  <Award className=\"w-4 h-4 text-[#6C7CE0]\" />\n                  <span className=\"text-xs font-mono font-semibold text-[#5161C5] uppercase\">Pengalaman Organisasi</span>\n                </div>\n                <h4 className=\"font-serif font-bold text-base text-[#2A2A3C]\">Ketua Komisi A MPK SMA</h4>\n                <p className=\"text-xs text-[#5A5A72] mt-1.5 leading-relaxed\">\n                  Membawahi fungsi legislasi, audit program kerja organisasi siswa, serta memfasilitasi komunikasi antara peserta didik dengan pihak manajemen sekolah secara transparan.\n                </p>\n              </div>\n            </div>"
      replacement_content: "            {/* Main Story Narrative */}\n            <div className=\"lg:col-span-7 bg-white rounded-2xl p-6 sm:p-8 border border-stone-200/90 shadow-xs space-y-4 text-left\">\n              <h3 className=\"font-serif font-bold text-xl text-[#2A2A3C] flex items-center gap-2\">\n                <span className=\"w-2 h-5 rounded-full bg-[#6C7CE0]\"></span>\n                Dedikasi Rekayasa Perangkat Lunak & Inovasi Cerdas\n              </h3>\n              \n              <p className=\"text-sm sm:text-base text-[#4A4A62] leading-relaxed\">\n                {PERSONAL_INFO.bio}\n              </p>\n\n              <p className=\"text-sm sm:text-base text-[#4A4A62] leading-relaxed\">\n                Karakter saya dibentuk oleh kedisiplinan dan tanggung jawab tinggi. Berpengalaman memimpin <strong>Komisi A MPK SMA Negeri 1 Bungursari</strong> serta dipercaya sebagai <strong>Wakil Ketua Bidang Sosial Politik GMNI Wastukancana Purwakarta</strong>, membekali saya dengan integritas tata kelola, kepemimpinan organisasi, manajemen waktu yang ketat, dan kebiasaan berpikir terstruktur dalam menyelesaikan masalah.\n              </p>\n\n              {/* Quote Box */}\n              <div className=\"p-4 rounded-xl bg-[#FDF9F3] border-l-3 border-[#6C7CE0] text-sm text-[#2A2A3C] font-medium italic mt-4\">\n                \"Teknologi terbaik bukan sekadar baris kode yang elegan, melainkan sistem yang handal, dapat dipertanggungjawabkan, dan memberikan dampak nyata bagi masyarakat.\"\n              </div>\n\n              {/* Highlights List */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\">\n                <div className=\"flex items-start gap-2.5\">\n                  <CheckCircle className=\"w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" />\n                  <span className=\"text-xs sm:text-sm text-[#4A4A62]\">\n                    Juara 1 Nasional KNEC 2026 (Ketahanan Pangan & Energi - AVO-BIO).\n                  </span>\n                </div>\n                <div className=\"flex items-start gap-2.5\">\n                  <CheckCircle className=\"w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5\" />\n                  <span className=\"text-xs sm:text-sm text-[#4A4A62]\">\n                    Top 10 Besar Nasional LEON 2026 (Aplikasi & Rekayasa Teknologi - FORCEMI).\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Quick Fact / Academics Card */}\n            <div className=\"lg:col-span-5 space-y-4\">\n              <div className=\"bg-white rounded-2xl p-6 border border-stone-200/90 shadow-xs text-left\">\n                <div className=\"flex items-center gap-3 mb-4\">\n                  <div className=\"w-10 h-10 rounded-xl bg-[#6C7CE0]/10 flex items-center justify-center text-[#6C7CE0]\">\n                    <GraduationCap className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <h4 className=\"font-serif font-bold text-base text-[#2A2A3C]\">STT Wastukancana</h4>\n                    <p className=\"text-xs text-[#5A5A72]\">Teknik Informatika \342\200\242 2025\342\200\223Sekarang</p>\n                  </div>\n                </div>\n                \n                <ul className=\"space-y-2.5 text-xs text-[#4A4A62] border-t border-stone-100 pt-3\">\n                  <li className=\"flex items-center justify-between\">\n                    <span className=\"text-[#6A6A82]\">Lokasi Kampus:</span>\n                    <span className=\"font-medium text-[#2A2A3C]\">Purwakarta, Jawa Barat</span>\n                  </li>\n                  <li className=\"flex items-center justify-between\">\n                    <span className=\"text-[#6A6A82]\">Fokus Riset:</span>\n                    <span className=\"font-medium text-[#2A2A3C]\">AI, IoT & Rekayasa Perangkat Lunak</span>\n                  </li>\n                  <li className=\"flex items-center justify-between\">\n                    <span className=\"text-[#6A6A82]\">Organisasi Aktif:</span>\n                    <span className=\"font-medium text-[#6C7CE0]\">Wakil Ketua Sospol GMNI Wastukancana</span>\n                  </li>\n                  <li className=\"flex items-center justify-between\">\n                    <span className=\"text-[#6A6A82]\">Status Akademik:</span>\n                    <span className=\"font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md\">Aktif Mahasiswa</span>\n                  </li>\n                </ul>\n              </div>\n\n              <div className=\"bg-gradient-to-br from-[#6C7CE0]/8 via-[#B48CE0]/8 to-white rounded-2xl p-6 border border-[#6C7CE0]/20 shadow-xs text-left\">\n                <div className=\"flex items-center gap-2 mb-2\">\n                  <Award className=\"w-4 h-4 text-[#6C7CE0]\" />\n                  <span className=\"text-xs font-mono font-semibold text-[#5161C5] uppercase\">Kepemimpinan & Organisasi</span>\n                </div>\n                <h4 className=\"font-serif font-bold text-base text-[#2A2A3C]\">GMNI & MPK SMA</h4>\n                <p className=\"text-xs text-[#5A5A72] mt-1.5 leading-relaxed\">\n                  Aktif memimpin advokasi sosial politik di GMNI Wastukancana Purwakarta serta pengalaman kepemimpinan legislasi siswa sebagai Ketua Komisi A MPK SMA Negeri 1 Bungursari.\n                </p>\n              </div>\n            </div>"
    }
