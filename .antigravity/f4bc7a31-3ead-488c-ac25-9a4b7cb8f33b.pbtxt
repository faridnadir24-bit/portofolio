  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-serif: \'Playfair Display\', Georgia, serif;\n    --font-sans: \'Outfit\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    color: #2A2A3C;\n    background-color: #FDFBF7;\n    background-image: \n      radial-gradient(circle at 10% 20%, rgba(108, 124, 224, 0.035) 0%, transparent 40%),\n      radial-gradient(circle at 90% 80%, rgba(180, 140, 224, 0.035) 0%, transparent 40%);\n    background-attachment: fixed;\n  }\n\n  h1, h2, h3, .font-serif {\n    font-family: var(--font-serif);\n  }\n\n  code, kbd, samp, pre, .font-mono {\n    font-family: var(--font-mono);\n  }\n}\n\n.font-serif-italic {\n  font-family: var(--font-serif);\n  font-style: italic;\n}\n\n/* Subtle glow orb styling */\n.orb-glow-periwinkle {\n  background: radial-gradient(circle, rgba(108, 124, 224, 0.16) 0%, rgba(108, 124, 224, 0.02) 65%, transparent 100%);\n  filter: blur(48px);\n}\n\n.orb-glow-lavender {\n  background: radial-gradient(circle, rgba(180, 140, 224, 0.16) 0%, rgba(180, 140, 224, 0.02) 65%, transparent 100%);\n  filter: blur(48px);\n}\n\n/* Card hover animation */\n.card-hover-lift {\n  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;\n}\n\n.card-hover-lift:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 16px 32px -8px rgba(108, 124, 224, 0.12), 0 4px 12px -2px rgba(42, 42, 60, 0.05);\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --bg: #FDF9F3;\n    --card-bg: #FFFFFF;\n    --ink: #2A2A3C;\n    --ink-muted: #5A5A72;\n    --periwinkle: #6C7CE0;\n    --lavender: #B48CE0;\n    --border: rgba(42, 42, 60, 0.08);\n\n    --font-serif: \'Playfair Display\', Georgia, serif;\n    --font-sans: \'Outfit\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    color: var(--ink);\n    background-color: var(--bg);\n    background-image: \n      radial-gradient(circle at 10% 15%, rgba(108, 124, 224, 0.035) 0%, transparent 45%),\n      radial-gradient(circle at 90% 85%, rgba(180, 140, 224, 0.035) 0%, transparent 45%);\n    background-attachment: fixed;\n  }\n\n  h1, h2, h3, .font-serif {\n    font-family: var(--font-serif);\n  }\n\n  code, kbd, samp, pre, .font-mono {\n    font-family: var(--font-mono);\n  }\n\n  /* Custom subtle minimalist scrollbar */\n  ::-webkit-scrollbar {\n    width: 7px;\n    height: 7px;\n  }\n  ::-webkit-scrollbar-track {\n    background: #FDF9F3;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: #D8D6E2;\n    border-radius: 9999px;\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background: #B6B4C8;\n  }\n}\n\n.font-serif-italic {\n  font-family: var(--font-serif);\n  font-style: italic;\n}\n\n/* Subtle glow orb styling */\n.orb-glow-periwinkle {\n  background: radial-gradient(circle, rgba(108, 124, 224, 0.14) 0%, rgba(108, 124, 224, 0.02) 65%, transparent 100%);\n  filter: blur(48px);\n}\n\n.orb-glow-lavender {\n  background: radial-gradient(circle, rgba(180, 140, 224, 0.14) 0%, rgba(180, 140, 224, 0.02) 65%, transparent 100%);\n  filter: blur(48px);\n}\n\n/* Card hover animation */\n.card-hover-lift {\n  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;\n}\n\n.card-hover-lift:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 16px 32px -8px rgba(108, 124, 224, 0.10), 0 4px 12px -2px rgba(42, 42, 60, 0.04);\n}"
    }
